# ==============================================================================
# Pixel Prize (.gitignore) - Collaborative AI Vibe-Coding Setup
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment & Secret Variables (CRITICAL FOR COLLABORATION)
# Note: Keep .env.example tracked so both AI agents know required environment keys!
# ------------------------------------------------------------------------------
.env
.env*.local
.env.development
.env.test
.env.production
*.pem
*.key
*.cert
serviceAccountKey*.json
mcp_config.local.json

# Explicitly ensure example environment templates are NEVER ignored
!.env.example
!frontend/.env.example
!backend/.env.example

# ------------------------------------------------------------------------------
# 2. Node.js & Package Managers
# ------------------------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-store/
.npm/

# ------------------------------------------------------------------------------
# 3. Next.js / React Build Outputs & Cache
# ------------------------------------------------------------------------------
.next/
out/
build/
dist/
.turbo/
.cache/
.eslintcache

# ------------------------------------------------------------------------------
# 4. Python & AI / Computer Vision Artifacts
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
eggs/
.eggs/
parts/
var/
sdist/
*.egg-info/
.installed.cfg
*.egg
.venv/
venv/
ENV/
env/
# Ignore heavy model weights / checkpoints (train models in Phase 2)
*.pt
*.pth
*.bin
*.onnx
*.safetensors
checkpoint-*/
runs/
wandb/

# ------------------------------------------------------------------------------
# 5. Database & Local Storage Data
# ------------------------------------------------------------------------------
*.sqlite
*.sqlite3
*.db
*.db-journal
*.db-wal
local_storage/
uploads/
uploads_temp/
*.log
*.tsbuildinfo

# ------------------------------------------------------------------------------
# 6. Operating System & Editor Files
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
*.swp
*.swo
*~

# IDE Files (Ignore machine-specific workspace configs, keep team configs)
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json

# Agent temporary logs and scratchpads
.system_generated/
*.tmp

# ------------------------------------------------------------------------------
# 7. EXPLICIT PRESERVATION (DO NOT IGNORE)
# ------------------------------------------------------------------------------
!docs/
!frontend/stitch_screens/
!AGENT_RULES.md
!AGENTS.md
!CLAUDE.md
!.cursorrules
!GEMINI.md
