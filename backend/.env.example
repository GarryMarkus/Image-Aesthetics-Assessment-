# Backend Environment Variables (.env.example)
# Copy to backend/.env

PORT=3001
NODE_ENV="development"
FRONTEND_ORIGIN="http://localhost:3000"

# Database (PostgreSQL - Neon / Supabase / Local)
DATABASE_URL="postgresql://postgres:password@localhost:5432/pixelprize?schema=public"

# Redis (BullMQ queue & caching)
REDIS_URL="redis://localhost:6379"

# Object Storage (Cloudflare R2 / AWS S3)
R2_ACCOUNT_ID="your_cloudflare_account_id"
R2_ACCESS_KEY_ID="your_r2_access_key_id"
R2_SECRET_ACCESS_KEY="your_r2_secret_access_key"
R2_BUCKET_NAME="pixel-prize-media"
R2_PUBLIC_DOMAIN="https://media.pixelprize.org"

# Authentication Shared Secret
AUTH_SECRET="generate_32_byte_random_string_via_openssl_rand_base64_32"

# AI Aesthetic Judging Engine
JUDGE_PROVIDER="gemini" # "gemini" | "custom_model" | "mock"
GEMINI_API_KEY="your_google_gemini_api_key"
GEMINI_MODEL_NAME="gemini-2.5-flash"

# Phase 2 Inference (Optional for MVP)
CUSTOM_MODEL_ENDPOINT="http://localhost:8000/v1/evaluate"
CUSTOM_MODEL_SECRET="internal_shared_secret"
