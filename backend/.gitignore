# ==============================================================================
# Pixel Prize - Backend (.gitignore)
# ==============================================================================

# Dependencies
node_modules/
.npm/

# Build outputs
dist/
build/
*.tsbuildinfo

# Environment variables
.env
.env.*
.env*.local
!.env.example

# Local databases and SQLite dev files
dev.db
dev.db-journal
dev.db-wal
*.sqlite
*.sqlite3
*.db

# Temporary media uploads & processing scratchpads
uploads/
uploads_temp/
local_storage/

# Runtime logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
logs/

# Coverage
coverage/
.nyc_output/

# Operating system and editor files
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json
