# ==============================================================================
# Pixel Prize (.env.example) - Master Environment Template
# Copy this file to .env or use the respective templates in frontend/ and backend/
# ==============================================================================

# Application & URLs
NODE_ENV="development"
PORT=3000
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:3001"

# Database (PostgreSQL - Neon / Supabase / Local Postgres)
DATABASE_URL="postgresql://postgres:password@localhost:5432/pixelprize?schema=public"

# Cache & Asynchronous Job Queue (Redis - Upstash / Dragonfly / Local Redis)
REDIS_URL="redis://localhost:6379"

# Object Storage (Cloudflare R2 / AWS S3 Compatible)
STORAGE_PROVIDER="r2" # "r2" or "s3"
R2_ACCOUNT_ID="your_cloudflare_account_id"
R2_ACCESS_KEY_ID="your_r2_access_key_id"
R2_SECRET_ACCESS_KEY="your_r2_secret_access_key"
R2_BUCKET_NAME="pixel-prize-media"
R2_PUBLIC_DOMAIN="https://media.pixelprize.org"

# Authentication (NextAuth / Auth.js v5)
AUTH_SECRET="generate_32_byte_random_string_via_openssl_rand_base64_32"
AUTH_URL="http://localhost:3000/api/auth"
GOOGLE_CLIENT_ID="your_google_oauth_client_id"
GOOGLE_CLIENT_SECRET="your_google_oauth_client_secret"
GITHUB_CLIENT_ID="your_github_oauth_client_id"
GITHUB_CLIENT_SECRET="your_github_oauth_client_secret"

# AI Aesthetic Judging Engine (Phase 1: Hosted Multimodal LLM)
JUDGE_PROVIDER="gemini" # "gemini" | "custom_model" | "mock"
GEMINI_API_KEY="your_google_gemini_api_key_from_google_ai_studio"
GEMINI_MODEL_NAME="gemini-2.5-flash"

# AI Judging Engine (Phase 2: Custom In-House GPU Microservice)
CUSTOM_MODEL_ENDPOINT="http://localhost:8000/v1/evaluate"
CUSTOM_MODEL_SECRET="internal_shared_secret"

# Stitch MCP Server (UI Prototypes & Screen Generation)
STITCH_MCP_URL="https://stitch.googleapis.com/mcp"
STITCH_API_KEY="AQ.Ab8RN6LK4dLTxszWi0NMrB3fjjcOVH2CGc5Cvt6kT46pSbOwYA"
